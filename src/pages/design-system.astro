---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import Button from '../components/Button.astro';
import Card from '../components/Card.astro';
import Grid from '../components/Grid.astro';
import CTABanner from '../components/CTABanner.astro';
import Accordion from '../components/Accordion.astro';

const colors = {
  Primary: [
    { name: 'primary', hex: '#1B3A5C', class: 'bg-primary' },
    { name: 'primary-light', hex: '#2E6DAE', class: 'bg-primary-light' },
    { name: 'primary-dark', hex: '#0F2440', class: 'bg-primary-dark' },
  ],
  Accent: [
    { name: 'accent', hex: '#C9A96E', class: 'bg-accent' },
    { name: 'accent-hover', hex: '#B8963F', class: 'bg-accent-hover' },
    { name: 'accent-light', hex: '#F5ECD7', class: 'bg-accent-light' },
  ],
  Cream: [
    { name: 'cream', hex: '#FAF6F1', class: 'bg-cream' },
    { name: 'cream-dark', hex: '#F0E8DD', class: 'bg-cream-dark' },
  ],
  Neutral: [
    { name: 'neutral-50', hex: '#FAFAFA', class: 'bg-neutral-50' },
    { name: 'neutral-100', hex: '#F5F5F5', class: 'bg-neutral-100' },
    { name: 'neutral-200', hex: '#E5E5E5', class: 'bg-neutral-200' },
    { name: 'neutral-300', hex: '#D4D4D4', class: 'bg-neutral-300' },
    { name: 'neutral-400', hex: '#A3A3A3', class: 'bg-neutral-400' },
    { name: 'neutral-500', hex: '#737373', class: 'bg-neutral-500' },
    { name: 'neutral-600', hex: '#525252', class: 'bg-neutral-600' },
    { name: 'neutral-700', hex: '#404040', class: 'bg-neutral-700' },
    { name: 'neutral-800', hex: '#262626', class: 'bg-neutral-800' },
    { name: 'neutral-900', hex: '#171717', class: 'bg-neutral-900' },
  ],
  Status: [
    { name: 'success', hex: '#10B981', class: 'bg-success' },
    { name: 'error', hex: '#EF4444', class: 'bg-error' },
  ],
};

const typeScale = [
  { label: 'Display', bemClass: 'text-display', classes: 'font-serif text-3xl md:text-5xl font-bold leading-tight' },
  { label: 'Heading 1', bemClass: 'text-h1', classes: 'font-serif text-2xl md:text-4xl font-bold leading-tight' },
  { label: 'Heading 2', bemClass: 'text-h2', classes: 'font-serif text-xl md:text-3xl font-semibold leading-snug' },
  { label: 'Heading 3', bemClass: 'text-h3', classes: 'font-sans text-lg md:text-xl font-semibold leading-snug' },
  { label: 'Heading 4', bemClass: 'text-h4', classes: 'font-sans text-base md:text-lg font-medium' },
  { label: 'Body Large', bemClass: 'text-body-lg', classes: 'font-sans text-lg leading-relaxed' },
  { label: 'Body', bemClass: 'text-body', classes: 'font-sans text-base leading-relaxed' },
  { label: 'Body Small', bemClass: 'text-body-sm', classes: 'font-sans text-sm leading-relaxed' },
  { label: 'Label', bemClass: 'text-label', classes: 'font-sans text-sm font-medium uppercase tracking-wide' },
];

const buttonVariants = [
  { variant: 'primary', bem: '.btn.btn--primary' },
  { variant: 'secondary', bem: '.btn.btn--secondary' },
  { variant: 'secondary-on-dark', bem: '.btn.btn--secondary-on-dark' },
  { variant: 'ghost', bem: '.btn.btn--ghost' },
  { variant: 'white', bem: '.btn.btn--white' },
] as const;

const buttonSizes = ['base', 'lg'] as const;
---

<BaseLayout
  title="Design System — Lading & Launch"
  description="Internal design reference."
  noindex={true}
>
  <!-- Section 1: Color Palette -->
  <Section background="white">
    <h1 class="text-h1 section__heading">Design System</h1>
    <h2 class="text-h2 section__heading">Color Palette</h2>
    {Object.entries(colors).map(([group, swatches]) => (
      <div class="mb-8">
        <h3 class="text-h3 mb-4">{group}</h3>
        <div class="flex flex-wrap gap-4">
          {swatches.map((swatch) => (
            <div class="flex flex-col items-center">
              <div class:list={[swatch.class, 'w-16 h-16 rounded-lg border border-neutral-200']} />
              <p class="text-xs font-medium mt-2 text-neutral-700">{swatch.name}</p>
              <p class="text-xs font-mono text-neutral-500">{swatch.hex}</p>
            </div>
          ))}
        </div>
      </div>
    ))}
  </Section>

  <!-- Section 2: Typography Scale -->
  <Section background="cream">
    <h2 class="text-h2 section__heading">Typography Scale</h2>
    <div class="space-y-8">
      {typeScale.map((entry) => (
        <div>
          <p class={entry.bemClass}>{entry.label}: The quick brown fox jumps over the lazy dog</p>
          <p class="font-mono text-xs text-neutral-500 mt-2">
            <code>.{entry.bemClass}</code> &rarr; {entry.classes}
          </p>
        </div>
      ))}
    </div>
  </Section>

  <!-- Section 3: Buttons -->
  <Section background="white">
    <h2 class="text-h2 section__heading">Buttons</h2>
    <p class="text-body-sm text-neutral-500 section__description">Hover for lift + shadow bloom. Click for press effect.</p>
    <div class="space-y-8">
      {buttonVariants.map(({ variant, bem }) => (
        <div>
          <h3 class="text-h3 mb-2">{variant}</h3>
          <p class="font-mono text-xs text-neutral-500 mb-4"><code>{bem}</code></p>
          {(variant === 'white' || variant === 'secondary-on-dark') ? (
            <div class="bg-primary rounded-xl p-6 flex flex-wrap gap-4 items-center">
              {buttonSizes.map((size) => (
                <Button variant={variant} size={size}>
                  {variant} / {size}
                </Button>
              ))}
            </div>
          ) : (
            <div class="flex flex-wrap gap-4 items-center">
              {buttonSizes.map((size) => (
                <Button variant={variant} size={size}>
                  {variant} / {size}
                </Button>
              ))}
            </div>
          )}
        </div>
      ))}
    </div>
  </Section>

  <!-- Section 4: Cards -->
  <Section background="cream">
    <h2 class="text-h2 section__heading">Cards</h2>
    <p class="font-mono text-xs text-neutral-500 section__description"><code>.card</code> &mdash; hover for lift + shadow effect</p>
    <Grid cols={2}>
      <Card>
        <h3 class="card__title">Plain Card</h3>
        <p class="card__description">This is a card without a link. It renders as a div.</p>
        <Button variant="primary">Learn More</Button>
      </Card>
      <Card href="#">
        <h3 class="card__title">Linked Card</h3>
        <p class="card__description">This card has an href and renders as a clickable anchor.</p>
        <span class="text-primary-light font-semibold">Click to visit &rarr;</span>
      </Card>
    </Grid>
  </Section>

  <!-- Section 5: Accordion -->
  <Section background="white">
    <h2 class="text-h2 section__heading">Accordion</h2>
    <p class="font-mono text-xs text-neutral-500 section__description"><code>.accordion</code> — native &lt;details&gt;/&lt;summary&gt; elements, zero JS</p>
    <Accordion items={[
      { question: 'How long does a project take?', answer: 'Timelines vary by project scope. Starter stores take 1-2 weeks, while complex builds can take 4-8 weeks. We provide a specific timeline during discovery.' },
      { question: 'Do you offer ongoing support?', answer: 'Yes. We offer monthly management plans starting at $300/mo that include updates, monitoring, and dev hours.' },
      { question: 'What platforms do you work with?', answer: 'Shopify only. We specialize in Shopify and Shopify Plus — that focus means deeper expertise for your store.' },
    ]} />
  </Section>

  <!-- Section 6: Grid Layouts -->
  <Section background="cream">
    <h2 class="text-h2 section__heading">Grid Layouts</h2>

    <h3 class="text-h3 mb-2">2 Columns</h3>
    <p class="font-mono text-xs text-neutral-500 mb-4"><code>.grid.grid--2col</code></p>
    <Grid cols={2} class="mb-8">
      {[1, 2].map((n) => (
        <Card><p class="text-center font-medium">Column {n}</p></Card>
      ))}
    </Grid>

    <h3 class="text-h3 mb-2">3 Columns</h3>
    <p class="font-mono text-xs text-neutral-500 mb-4"><code>.grid.grid--3col</code></p>
    <Grid cols={3} class="mb-8">
      {[1, 2, 3].map((n) => (
        <Card><p class="text-center font-medium">Column {n}</p></Card>
      ))}
    </Grid>

    <h3 class="text-h3 mb-2">4 Columns</h3>
    <p class="font-mono text-xs text-neutral-500 mb-4"><code>.grid.grid--4col</code></p>
    <Grid cols={4}>
      {[1, 2, 3, 4].map((n) => (
        <Card><p class="text-center font-medium">Column {n}</p></Card>
      ))}
    </Grid>
  </Section>

  <!-- Section 6: Section Backgrounds -->
  <Section background="white">
    <h2 class="text-h2 section__heading">White Background</h2>
    <p class="font-mono text-xs text-neutral-500 mb-2"><code>.section.section--white</code></p>
    <p class="text-body">This section uses the white background with dark text.</p>
  </Section>
  <Section background="cream">
    <h2 class="text-h2 section__heading">Cream Background</h2>
    <p class="font-mono text-xs text-neutral-500 mb-2"><code>.section.section--cream</code></p>
    <p class="text-body">This section uses the cream background with dark text.</p>
  </Section>
  <Section background="primary">
    <h2 class="text-h2 section__heading">Primary Background</h2>
    <p class="font-mono text-xs text-neutral-500 mb-2"><code>.section.section--primary</code></p>
    <p class="text-body">This section uses the primary navy background with white text.</p>
  </Section>
  <Section background="primary-dark">
    <h2 class="text-h2 section__heading">Primary Dark Background</h2>
    <p class="font-mono text-xs text-neutral-500 mb-2"><code>.section.section--primary-dark</code></p>
    <p class="text-body">This section uses the dark navy background with white text.</p>
  </Section>

  <!-- Section 7: CTA Banner -->
  <CTABanner />

  <!-- Section 8: Form Elements -->
  <Section background="white">
    <h2 class="text-h2 section__heading">Form Elements</h2>
    <form class="max-w-lg" onsubmit="return false;">
      <div class="form__group">
        <label for="demo-name" class="form__label">Full Name</label>
        <input type="text" id="demo-name" placeholder="Jane Doe" class="form__input" />
        <p class="font-mono text-xs text-neutral-400 mt-1"><code>.form__label</code> + <code>.form__input</code></p>
      </div>
      <div class="form__group">
        <label for="demo-email" class="form__label">Email Address</label>
        <input type="email" id="demo-email" placeholder="jane@example.com" class="form__input" />
      </div>
      <div class="form__group">
        <label for="demo-service" class="form__label">Service</label>
        <select id="demo-service" class="form__input bg-white">
          <option value="">Select a service</option>
          <option value="build">Store Build</option>
          <option value="optimize">Optimization</option>
          <option value="migrate">Migration</option>
          <option value="manage">Management</option>
        </select>
      </div>
      <div class="form__group">
        <label for="demo-message" class="form__label">Message</label>
        <textarea id="demo-message" rows="4" placeholder="Tell us about your project..." class="form__textarea"></textarea>
        <p class="font-mono text-xs text-neutral-400 mt-1"><code>.form__textarea</code></p>
      </div>
      <Button variant="primary">Submit</Button>
    </form>
  </Section>

  <!-- Section 9: Animations & Interactions -->
  <Section background="cream">
    <h2 class="text-h2 section__heading">Animations &amp; Interactions</h2>
    <p class="text-body section__description">All animations respect <code>prefers-reduced-motion</code>. JS is limited to IntersectionObserver for scroll triggers.</p>

    <!-- Buttons & Cards -->
    <h3 class="text-h3 mb-4">Button Hover Effects</h3>
    <p class="text-body-sm text-neutral-600 mb-4">Hover any button above for: lift (<code>translateY(-2px)</code>), shadow bloom, and active press-down effect. Built into <code>.btn</code>.</p>

    <h3 class="text-h3 mb-4">Card Hover Effects</h3>
    <p class="text-body-sm text-neutral-600 mb-6">Hover any card above for: lift (<code>translateY(-4px)</code>) + shadow grow. Built into <code>.card</code>.</p>

    <!-- Fade In on Scroll -->
    <h3 class="text-h3 mb-2">Fade In on Scroll</h3>
    <p class="font-mono text-xs text-neutral-500 mb-4"><code>.animate-fade-in</code></p>
    <div class="grid grid--3col mb-8">
      <div class="animate-fade-in card text-center p-6">
        <p class="font-medium">Fade In Box 1</p>
      </div>
      <div class="animate-fade-in card text-center p-6">
        <p class="font-medium">Fade In Box 2</p>
      </div>
      <div class="animate-fade-in card text-center p-6">
        <p class="font-medium">Fade In Box 3</p>
      </div>
    </div>

    <!-- Staggered Fade In -->
    <h3 class="text-h3 mb-2">Staggered Fade In</h3>
    <p class="font-mono text-xs text-neutral-500 mb-4"><code>.animate-fade-in-stagger</code> on parent &mdash; children stagger with 100ms delay</p>
    <div class="animate-fade-in-stagger grid grid--4col mb-8">
      {[1, 2, 3, 4].map((n) => (
        <div class="card text-center p-6">
          <p class="font-medium">Item {n}</p>
        </div>
      ))}
    </div>

    <!-- Float -->
    <h3 class="text-h3 mb-2">Float</h3>
    <p class="font-mono text-xs text-neutral-500 mb-4"><code>.animate-float</code> &mdash; gentle infinite floating motion</p>
    <div class="flex gap-6 mb-8">
      <div class="animate-float w-20 h-20 rounded-xl bg-accent flex items-center justify-center">
        <span class="text-primary-dark font-bold text-sm">Float</span>
      </div>
      <div class="animate-float w-20 h-20 rounded-xl bg-primary flex items-center justify-center" style="animation-delay: 500ms;">
        <span class="text-white font-bold text-sm">Float</span>
      </div>
    </div>

    <!-- Scale In -->
    <h3 class="text-h3 mb-2">Scale In</h3>
    <p class="font-mono text-xs text-neutral-500 mb-4"><code>.animate-scale-in</code> &mdash; scale from 95% + fade entrance (200ms)</p>
    <div class="animate-scale-in card inline-block text-center p-6 mb-8">
      <p class="font-medium">Scale In Box</p>
    </div>

    <!-- Link Underline -->
    <h3 class="text-h3 mb-2">Link Underline</h3>
    <p class="font-mono text-xs text-neutral-500 mb-4"><code>.link-underline</code> &mdash; expanding gold underline on hover</p>
    <div class="flex gap-6">
      <a href="#" class="link-underline text-neutral-700 font-medium">Hover me</a>
      <a href="#" class="link-underline text-primary-light font-medium">Another link</a>
      <a href="#" class="link-underline text-neutral-700 font-medium">Third example</a>
    </div>
  </Section>
</BaseLayout>
