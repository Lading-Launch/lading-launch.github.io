---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import Button from '../components/Button.astro';
import Card from '../components/Card.astro';
import Grid from '../components/Grid.astro';
import CTABanner from '../components/CTABanner.astro';
import Icon from '../components/Icon.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "name": "Lading & Launch",
      "url": "https://ladingandlaunch.com",
      "description": "Shopify store builds, optimizations, and management for DTC brands. Plus powerful Shopify apps.",
    },
    {
      "@type": "WebSite",
      "name": "Lading & Launch",
      "url": "https://ladingandlaunch.com"
    }
  ]
};

const services = [
  { title: 'Shopify Store Builds', icon: 'storefront', description: 'Custom Shopify stores designed to convert — from theme customization to full custom builds. Starting at $2,000.', href: '/services/store-builds/' },
  { title: 'Store Optimization', icon: 'speedometer', description: 'Speed, SEO, and conversion improvements for stores that need to perform better. Starting at $500.', href: '/services/optimization/' },
  { title: 'Platform Migration', icon: 'transfer', description: 'Move from WooCommerce, Wix, Squarespace, or BigCommerce to Shopify. Zero data loss. Starting at $1,500.', href: '/services/migration/' },
  { title: 'Monthly Management', icon: 'settings', description: 'Ongoing store management, updates, and optimization so you can focus on growing your brand. Starting at $300/mo.', href: '/services/management/' },
];

const differentiators = [
  { icon: 'target', title: 'Shopify-Only Focus', description: 'Every project, every line of code, every optimization — it\'s all Shopify. Specialization means deeper expertise and better results for your store.' },
  { icon: 'price-tag', title: 'Transparent Pricing', description: 'Fixed prices published on our website. No "request a quote" black box. You know what you\'re paying before the first call.' },
  { icon: 'lightning', title: 'Fast Delivery', description: 'A starter store in 1–2 weeks, not 4–6. Lean operations and modern tooling mean your store launches faster without cutting corners.' },
  { icon: 'code', title: 'Builders, Not Just Implementers', description: 'We don\'t just set up themes — we build Shopify apps. That deeper technical expertise shows in every store we build.' },
];

const apps = [
  { title: 'DealSnap', description: 'Flexible discount engine for Shopify. Create mix-and-match bundles, quantity breaks, and automatic discount combinations — without the workarounds.' },
  { title: 'Scratch & Win', description: 'Gamified scratch cards that capture emails and drive urgency. Visitors scratch to reveal a discount — more engaging than another boring popup.' },
];

const steps = [
  { number: '01', icon: 'phone', title: 'Discovery Call', description: 'We learn about your brand, your goals, and your Shopify challenges. You get honest recommendations — even if that means you don\'t need us.' },
  { number: '02', icon: 'hammer', title: 'Build & Launch', description: 'We build your store with conversion and SEO baked in from day one. You review, we refine, and we launch when you\'re happy.' },
  { number: '03', icon: 'chart-up', title: 'Grow & Optimize', description: 'After launch, we monitor performance and make ongoing improvements. Your store gets better every month, not just on day one.' },
];
---

<BaseLayout
  title="Lading & Launch | Shopify E-Commerce Agency & App Development"
  description="Shopify store builds, optimizations, and management for DTC brands. Plus powerful Shopify apps. Expert Shopify development for growing e-commerce brands."
  schema={schema}
>
  <!-- Section 1: Hero -->
  <Section background="primary" hero>
    <div class="text-center animate-fade-in">
      <p class="text-label text-accent mb-4">Shopify Agency + App Development</p>
      <h1 class="text-display text-white section__heading">Shopify Stores Built to Sell</h1>
      <p class="text-body-lg text-neutral-300 section__description max-w-2xl mx-auto">We build, optimize, and manage Shopify stores for e-commerce brands that are ready to grow. Fixed pricing. Fast delivery. Shopify is all we do.</p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <Button variant="primary" size="lg" href="/contact/">Book a Discovery Call</Button>
        <Button variant="secondary-on-dark" size="lg" href="/services/">View Services</Button>
      </div>
    </div>
  </Section>

  <!-- Section 2: Services Overview -->
  <Section background="cream">
    <div class="text-center animate-fade-in">
      <h2 class="text-h2 section__heading">What We Do</h2>
      <p class="section__description text-body-lg text-neutral-600 max-w-2xl mx-auto">Shopify expertise across every stage of your store's lifecycle.</p>
    </div>
    <Grid cols={4} class="animate-fade-in-stagger">
      {services.map((service) => (
        <Card href={service.href}>
          <Icon name={service.icon} size={36} class="text-accent mb-4" />
          <h3 class="card__title">{service.title}</h3>
          <p class="card__description">{service.description}</p>
          <span class="text-body-sm text-primary-light font-semibold">Learn more &rarr;</span>
        </Card>
      ))}
    </Grid>
  </Section>

  <!-- Section 3: Why Lading & Launch -->
  <Section background="white">
    <div class="text-center animate-fade-in">
      <h2 class="text-h2 section__heading">Why Brands Choose Us</h2>
      <p class="section__description text-body-lg text-neutral-600 max-w-2xl mx-auto">We're not a "we do everything" agency. We do Shopify. That's it.</p>
    </div>
    <Grid cols={2} class="animate-fade-in-stagger">
      {differentiators.map((item) => (
        <div>
          <Icon name={item.icon} size={40} class="text-accent mb-4" />
          <h3 class="text-h3 mb-3">{item.title}</h3>
          <p class="text-body text-neutral-600">{item.description}</p>
        </div>
      ))}
    </Grid>
  </Section>

  <!-- Section 4: Apps Showcase -->
  <Section background="cream">
    <div class="text-center animate-fade-in">
      <h2 class="text-h2 section__heading">Shopify Apps We're Building</h2>
      <p class="section__description text-body-lg text-neutral-600 max-w-2xl mx-auto">Tools that solve real merchant problems — built by the same team that builds your store.</p>
    </div>
    <Grid cols={2} class="animate-fade-in-stagger">
      {apps.map((app) => (
        <Card>
          <p class="text-label text-accent mb-4">Coming Soon</p>
          <h3 class="card__title">{app.title}</h3>
          <p class="card__description">{app.description}</p>
        </Card>
      ))}
    </Grid>
  </Section>

  <!-- Section 5: How It Works -->
  <Section background="white">
    <div class="text-center animate-fade-in">
      <h2 class="text-h2 section__heading">How It Works</h2>
      <p class="section__description text-body-lg text-neutral-600 max-w-2xl mx-auto">From first conversation to live store — here's what to expect.</p>
    </div>
    <div class="max-w-2xl mx-auto space-y-10 animate-fade-in">
      {steps.map((step) => (
        <div class="flex gap-6">
          <span class="text-4xl font-bold text-accent shrink-0">{step.number}</span>
          <div>
            <h3 class="text-h3 mb-3">{step.title}</h3>
            <p class="text-body text-neutral-600">{step.description}</p>
          </div>
        </div>
      ))}
    </div>
  </Section>

  <!-- Section 6: Social Proof -->
  <Section background="cream">
    <div class="text-center animate-fade-in">
      <h2 class="text-h2 section__heading">We're Just Getting Started</h2>
      <p class="text-body-lg text-neutral-700 max-w-2xl mx-auto section__description">Lading &amp; Launch is a new Shopify agency built by an experienced developer who decided to go all-in on the platform. We don't have 200 case studies yet — but we have deep Shopify expertise, transparent pricing, and a commitment to doing great work for every client.</p>
      <Button variant="primary" href="/contact/">Be one of our first clients &rarr;</Button>
    </div>
  </Section>

  <!-- Section 7: CTA Banner -->
  <CTABanner />
</BaseLayout>
