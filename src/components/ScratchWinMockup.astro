---

<div class="w-full max-w-sm mx-auto">
  <div class="rounded-2xl overflow-hidden shadow-sm border border-neutral-200">
    <!-- Scratch Card -->
    <div class="bg-accent relative p-8 text-center">
      <!-- Scratched area reveal -->
      <div class="bg-white/95 rounded-xl p-6 relative">
        <p class="text-xs text-neutral-500 uppercase tracking-wide mb-2">You revealed</p>
        <p class="font-serif text-2xl font-bold text-primary">15% Off</p>
        <p class="text-sm text-neutral-600 mt-1">Your entire order</p>
        <p class="font-mono text-xs text-accent-hover mt-3 bg-accent-light rounded px-3 py-1.5 inline-block">SCRATCH15</p>
      </div>
      <!-- Unscratched texture hint -->
      <div class="absolute top-2 right-2 w-16 h-10 rounded bg-accent-hover/40 flex items-center justify-center">
        <span class="text-white/60 text-xs">✦ ✦ ✦</span>
      </div>
    </div>
    <!-- Email Capture -->
    <div class="bg-white p-5">
      <p class="text-sm font-medium text-neutral-800 mb-3">Enter your email to claim:</p>
      <div class="flex gap-2">
        <div class="flex-1 rounded-lg border border-neutral-300 px-3 py-2">
          <span class="text-sm text-neutral-400">your@email.com</span>
        </div>
        <div class="rounded-lg bg-primary px-4 py-2 flex items-center">
          <span class="text-white text-sm font-medium">Claim</span>
        </div>
      </div>
    </div>
  </div>
</div>
