---

{pathData && (
  <svg
    xmlns="http://www.w3.org/2000/svg"
    width={size}
    height={size}
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    class:list={[className]}
    aria-hidden="true"
  >
    {pathData.split(' M').map((segment, i) => (
      <path d={i === 0 ? segment : `M${segment}`} />
    ))}
  </svg>
)}
