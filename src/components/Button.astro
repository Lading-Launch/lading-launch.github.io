---
interface Props {
  variant?: 'primary' | 'secondary' | 'secondary-on-dark' | 'ghost' | 'white';
  href?: string;
  size?: 'sm' | 'base' | 'lg';
  class?: string;
}

const { variant = 'primary', href, size = 'base', class: className } = Astro.props;

const variantClass = `btn--${variant}`;
const sizeClasses: Record<string, string> = { sm: 'btn--sm', base: '', lg: 'btn--lg' };
const sizeClass = sizeClasses[size] || '';
---

{href ? (
  <a href={href} class:list={['btn', variantClass, sizeClass, className]}>
    <slot />
  </a>
) : (
  <button class:list={['btn', variantClass, sizeClass, className]}>
    <slot />
  </button>
)}
