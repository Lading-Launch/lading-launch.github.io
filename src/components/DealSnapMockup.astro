---
---

<div class="w-full max-w-md mx-auto">
  <div class="rounded-xl border border-neutral-200 bg-white shadow-sm overflow-hidden">
    <!-- Header -->
    <div class="bg-primary px-5 py-3 flex items-center gap-3">
      <div class="w-6 h-6 rounded bg-accent flex items-center justify-center">
        <span class="text-primary-dark text-xs font-bold">D</span>
      </div>
      <span class="text-white font-semibold text-sm">DealSnap</span>
      <span class="text-neutral-300 text-xs ml-auto">Discount Rules</span>
    </div>
    <!-- Rules -->
    <div class="divide-y divide-neutral-100">
      <div class="px-5 py-3.5 flex items-center justify-between">
        <div>
          <p class="text-sm font-medium text-neutral-800">Buy 3, Get 15% Off</p>
          <p class="text-xs text-neutral-500 mt-0.5">Summer Collection</p>
        </div>
        <div class="w-9 h-5 rounded-full bg-accent relative">
          <div class="w-4 h-4 rounded-full bg-white absolute right-0.5 top-0.5"></div>
        </div>
      </div>
      <div class="px-5 py-3.5 flex items-center justify-between">
        <div>
          <p class="text-sm font-medium text-neutral-800">Mix & Match: Any 2 Candles</p>
          <p class="text-xs text-neutral-500 mt-0.5">$5 off bundle</p>
        </div>
        <div class="w-9 h-5 rounded-full bg-accent relative">
          <div class="w-4 h-4 rounded-full bg-white absolute right-0.5 top-0.5"></div>
        </div>
      </div>
      <div class="px-5 py-3.5 flex items-center justify-between">
        <div>
          <p class="text-sm font-medium text-neutral-800">Quantity Break: 5+ Items</p>
          <p class="text-xs text-neutral-500 mt-0.5">20% automatic discount</p>
        </div>
        <div class="w-9 h-5 rounded-full bg-neutral-200 relative">
          <div class="w-4 h-4 rounded-full bg-white absolute left-0.5 top-0.5"></div>
        </div>
      </div>
    </div>
    <!-- Footer -->
    <div class="px-5 py-3 bg-cream-dark flex items-center justify-between">
      <span class="text-xs text-neutral-500">2 active rules</span>
      <span class="text-xs text-primary-light font-medium">+ Add Rule</span>
    </div>
  </div>
</div>
