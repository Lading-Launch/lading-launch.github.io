---
interface Props {
  background?: 'white' | 'cream' | 'primary' | 'primary-dark';
  compact?: boolean;
  hero?: boolean;
  id?: string;
  class?: string;
}

const { background = 'white', compact = false, hero = false, id, class: className } = Astro.props;

const modifierMap: Record<string, string> = {
  'white': 'section--white',
  'cream': 'section--cream',
  'primary': 'section--primary',
  'primary-dark': 'section--primary-dark',
};
---

<section
  id={id}
  class:list={[
    'section',
    modifierMap[background],
    hero && 'section--hero',
    compact && 'section--compact',
    className,
  ]}
>
  <div class="container">
    <slot />
  </div>
</section>
