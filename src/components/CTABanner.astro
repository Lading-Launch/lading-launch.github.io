---
import Section from './Section.astro';
import Button from './Button.astro';

interface Props {
  heading?: string;
  description?: string;
  buttonText?: string;
  buttonHref?: string;
}

const {
  heading = 'Ready to Launch Your Store?',
  description = "Book a free discovery call and let's talk about your Shopify project.",
  buttonText = 'Book a Discovery Call',
  buttonHref = '/contact/',
} = Astro.props;
---

<Section background="primary">
  <div class="cta-banner">
    <h2 class="cta-banner__heading">{heading}</h2>
    <p class="cta-banner__description">{description}</p>
    <Button variant="white" size="lg" href={buttonHref}>{buttonText}</Button>
  </div>
</Section>
